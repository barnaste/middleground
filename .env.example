# =============================================================================
# Middleground Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!
# -----------------------------------------------------------------------------
# Supabase Authentication
# -----------------------------------------------------------------------------
# Your Supabase project URL (without trailing slash)
SUPABASE_ID=
SUPABASE_PASS=
SUPABASE_API_KEY=
SUPABASE_URL=https://${SUPABASE_ID}.supabase.co

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL via Supabase)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.${SUPABASE_ID}:{SUPABASE_PASS}@aws-1-us-east-1.pooler.supabase.com:5432/postgres"
DB_MAX_CONNECTIONS=15
DB_MIN_CONNECTIONS=5

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# For Docker Compose, use: redis://redis:6379
# For local development, use: redis://localhost:6379
REDIS_URL="redis://redis:6379"

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Control Rust tracing output verbosity
# Options: trace, debug, info, warn, error
RUST_LOG=info,api_gateway=debug,ws=debug,auth=debug,db=debug

# Enable backtraces for better error debugging
# 0 = disabled, 1 = enabled, full = full backtraces
RUST_BACKTRACE=1
